# Backend
NODE_ENV=development
PORT=5000
SERVE_STATIC=false
MONGODB_URI=mongodb://127.0.0.1:27017/lateNightCraving
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
CLIENT_URL=http://localhost:5173

# Change these before first production deployment
ADMIN_ADITYA_PASSWORD=ChangeThisAdityaPassword
ADMIN_AMLESH_PASSWORD=ChangeThisAmleshPassword

# Twilio alerts (E.164 numbers; WhatsApp destination must start with whatsapp:)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CALL_FROM=
TWILIO_CALL_URL=http://demo.twilio.com/docs/voice.xml
ALERT_TO_WHATSAPP=
ALERT_TO_PHONE=
TWILIO_ENABLE_CALLS=false
